# Production marketing site URL (must match live domain for SEO canonicals / sitemap)
NEXT_PUBLIC_APP_URL=https://www.fitzenix.app

# Google Search Console HTML-tag verification (strongly recommended for ranking)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxx

# ── API (mirrors Fitzenix/src/api/client.ts) ───────────────────────────────
# false = local backend on :4000 | true = production API
NEXT_PUBLIC_USE_REMOTE_API=true

# Production / remote backend origin (no /api/v1 suffix)
NEXT_PUBLIC_REMOTE_API_URL=https://api.fitzenix.app

# Local backend origin when NEXT_PUBLIC_USE_REMOTE_API=false
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:4000

# API path prefix (same as mobile API_BASE_URL …/api/v1)
NEXT_PUBLIC_API_PREFIX=/api/v1

# Local Frontend CORS fix when using live API from localhost:3000
NEXT_PUBLIC_USE_API_PROXY=true

# Optional full override (if set, wins over remote/local switch above)
# NEXT_PUBLIC_API_URL=https://api.fitzenix.app

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Optional deep links
NEXT_PUBLIC_LOGIN_URL=/login
NEXT_PUBLIC_APP_DOWNLOAD_URL=#download
NEXT_PUBLIC_APP_CONTINUE_URL=#

# Optional social profiles (leave blank to hide)
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Optional Razorpay plan identifiers (server-only) — starter / growth / pro
RAZORPAY_PLAN_STARTER=plan_starter
RAZORPAY_PLAN_GROWTH=plan_growth
RAZORPAY_PLAN_PRO=plan_pro

# Firebase Analytics (Web) — Firebase Console → Project settings → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fitzenix-db5c3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
